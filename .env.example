# GraphRAG Assistant — environment variables
# Copy this file to .env and fill in your values.
# docker-compose.yml loads .env automatically.

# ── SurrealDB ─────────────────────────────────────────────────────────────────
# When running in Docker, the URL is overridden to ws://surrealdb:8000/rpc
# by docker-compose.yml. This value is used when running locally outside Docker.
SURREALDB_URL=ws://localhost:8001/rpc
SURREALDB_NAMESPACE=lightrag
SURREALDB_DATABASE=assistant
SURREALDB_USERNAME=root
SURREALDB_PASSWORD=root

# ── Vector index ─────────────────────────────────────────────────────────────
# Must match the embedding model's output dimension.
# all-MiniLM-L6-v2 → 384   |   nomic-embed-text → 768
SURREALDB_VECTOR_DIM=384
SURREALDB_HNSW_EF=64
SURREALDB_HNSW_M=16

# ── Ollama ────────────────────────────────────────────────────────────────────
# When running in Docker, this is overridden to http://host.docker.internal:11434
# so the container can reach Ollama running on the host.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# ── Embedding model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Query-time LLM ────────────────────────────────────────────────────────────
# 'ollama' = fully local, no API key needed
# 'anthropic' = Claude Haiku via API (set ANTHROPIC_API_KEY below)
QUERY_LLM_PROVIDER=ollama

# Only needed if QUERY_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Ingestion pipeline ────────────────────────────────────────────────────────
# Absolute path to your ebook library on the HOST machine.
# Mounted into the container as /library (read-only).
LIBRARY_PATH=/path/to/your/library

# LightRAG working directory — stores graph state, checkpoints, etc.
LIGHTRAG_WORKING_DIR=./lightrag_data

# Max concurrent LightRAG inserts (limits Ollama load during ingestion)
MAX_CONCURRENT_INSERTS=4
