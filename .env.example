# GraphRAG Assistant — environment variables
# Copy this file to .env and fill in your values.
#
# Precedence (highest wins):  environment / .env  >  config.yaml  >  built-in defaults.
# A key set in both .env and config.yaml (with different values) logs a "Config conflict"
# warning at startup, and the .env value wins. Secrets belong here, never in config.yaml.

# ── Neo4j (property graph + vector store) ─────────────────────────────────────
# The post-migration storage backend (replaces the old embedded SurrealKV store).
NEO4J_URL=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=                       # REQUIRED — ingest.py refuses to start if unset
NEO4J_DATABASE=llamaindex

# ── Ollama (ingestion-time LLM: entity extraction) ────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b              # general/default model; must be pulled

# Extraction model for the curated-slice LLM pass. Unset → falls back to OLLAMA_MODEL.
# A fast small model here speeds up extraction independent of any query-role model.
# EXTRACT_MODEL=qwen3:4b-q8_0

# Thinking mode for the extraction model: auto | on | off | none.
# 'off'/'auto' recommended — thinking models (qwen3, deepseek-r1, …) otherwise emit
# reasoning tokens per chunk (slow). 'auto' disables it for thinking-capable models
# (matched by name) and leaves non-thinking models (qwen2.5) untouched.
# 'none' omits the flag entirely regardless of model name — use it if a model is
# wrongly detected as thinking-capable and errors on the `think` param.
# EXTRACT_THINKING=auto

# Extractor: schema | simple. 'schema' (default) = SchemaLLMPathExtractor with a
# constrained vocabulary — a clean, traversable graph. 'simple' = free-form
# SimpleLLMPathExtractor (noisy; for comparison).
# EXTRACTOR=schema

# Schema JSON: {"entity_types":[{"type":...}], "relation_types":[{"type":...}]}.
# Unset → built-in fallback vocabulary in ingest.py. Drives both the schema extractor
# and the relation canonicalizer below.
# SCHEMA_PATH=schemas/target_schema.json      # or schemas/test_schema.json for the 2-book test

# Canonicalize free-form relation labels to the schema's relation vocabulary via
# embedding similarity. Recommended path: local models can't self-constrain relation
# types (schema strict mode returns empty; non-strict is ignored), so extract free-form
# (EXTRACTOR=simple) and snap labels here. false → sanitize backticks only (raw labels).
# CANONICALIZE=true

# ── Embedding model ───────────────────────────────────────────────────────────
# VECTOR_DIM must match the model's output dimension.
# all-MiniLM-L6-v2 → 384   |   nomic-embed-text → 768
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_DIM=384

# ── Ingestion pipeline ────────────────────────────────────────────────────────
# Absolute path to your ebook library (PDF/EPUB, searched recursively).
LIBRARY_PATH=C:\path\to\your\library

# Working directory — checkpoints, raw-chunk cache, extract-progress, logs.
WORKING_DIR=./lightrag_data

# CPU-bound extraction worker pool size. Capped below cpu_count() to avoid OOM
# (each worker runs a full docling+EasyOCR pipeline).
EXTRACTION_WORKERS=8

# Max concurrent LlamaIndex inserts (limits Ollama load during ingestion).
MAX_CONCURRENT_INSERTS=4

# Ollama request timeout (seconds) for curated-slice entity extraction.
INSERT_TIMEOUT=300

# Curated-slice LLM extraction knobs.
MAX_PATHS_PER_CHUNK=10
EXTRACT_NUM_WORKERS=4

# ── Query-time LLM (api.py) ───────────────────────────────────────────────────
# 'ollama' = fully local, no API key needed
# 'anthropic' = Claude Haiku via API (set ANTHROPIC_API_KEY below)
QUERY_LLM_PROVIDER=ollama
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
