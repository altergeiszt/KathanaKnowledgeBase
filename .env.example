# GraphRAG Assistant — environment variables
# Copy this file to .env and fill in your values.

# ── SurrealDB (embedded SurrealKV) ────────────────────────────────────────────
# The database is an embedded, file-backed SurrealKV store opened in-process as
# surrealkv://<SURREALDB_PATH>. There is no server, URL, username, or password.
SURREALDB_PATH=./lightrag_data/graphrag.db
SURREALDB_NAMESPACE=lightrag
SURREALDB_DATABASE=assistant

# ── Vector index ─────────────────────────────────────────────────────────────
# Must match the embedding model's output dimension.
# all-MiniLM-L6-v2 → 384   |   nomic-embed-text → 768
SURREALDB_VECTOR_DIM=384
SURREALDB_HNSW_EF=64
SURREALDB_HNSW_M=16

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# ── Embedding model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Query-time LLM ────────────────────────────────────────────────────────────
# 'ollama' = fully local, no API key needed
# 'anthropic' = Claude Haiku via API (set ANTHROPIC_API_KEY below)
QUERY_LLM_PROVIDER=ollama

# Only needed if QUERY_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Ingestion pipeline ────────────────────────────────────────────────────────
# Absolute path to your ebook library.
LIBRARY_PATH=C:\path\to\your\library

# LightRAG working directory — stores graph state, checkpoints, etc.
LIGHTRAG_WORKING_DIR=./lightrag_data

# Max concurrent LightRAG inserts (limits Ollama load during ingestion)
MAX_CONCURRENT_INSERTS=4

# CPU-bound extraction worker pool size. Capped below cpu_count() to avoid OOM
# (each worker runs a full docling+EasyOCR pipeline).
EXTRACTION_WORKERS=8
